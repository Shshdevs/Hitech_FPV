APP_NAME="Hitech FPV API"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hitech_fpv
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10